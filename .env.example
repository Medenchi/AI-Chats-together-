# Telegram Bot (должен иметь can_manage_bots=true через BotFather MiniApp для Managed Bots)
MASTER_BOT_TOKEN=
GROUP_ID=-1001234567890

# ID пользователей-админов (через запятую). Только они могут создавать/управлять ботами.
# Узнать свой ID: напиши @userinfobot или @getmyid_bot
ADMIN_USER_IDS=

# AI Provider — FreeModel.dev (https://freemodel.dev)
# Регистрируйся, получай $300 бесплатных кредитов, генери API ключ в дашборде
FREEMODEL_API_KEY=
FREEMODEL_BASE_URL=https://api.freemodel.dev/v1

# Доступные модели на FreeModel.dev (ПОЛНЫЙ список из /v1/models):
#   gpt-5.5        — Флагман, 1M контекст    (FRE-5.5)  Лучший для reasoning/agentic
#   gpt-5.4        — Пред. флагман, 1M контекст (FRE-5.4)  General purpose
#   gpt-5.4-mini   — Облегчённая, 200K контекст           Быстрые задачи/subagents
#   gpt-5.3-codex  — Кодинг-специалист, 200K контекст     Генерация кода/agentic coding
# Модели случайно назначаются персонажам при создании
AVAILABLE_MODELS=gpt-5.5,gpt-5.4,gpt-5.4-mini,gpt-5.3-codex

DATABASE_PATH=data/bots.db
LOG_LEVEL=INFO
LOG_FILE=data/bots.log

MIN_MESSAGE_INTERVAL=120
MAX_MESSAGE_INTERVAL=1800
DEFAULT_REPLY_CHANCE=0.7
INITIATE_CHAT_CHANCE=0.15
SLEEP_START_HOUR=1
SLEEP_END_HOUR=9
WAKE_UP_CHANCE=0.3
INITIAL_CHARACTERS=2
MAX_CLONES_PER_CHARACTER=3
MAX_TOTAL_BOTS=10
